{
  "expo": {
    "name": "Ledger",
    "slug": "ledger-cr",
    "scheme": "ledgercr",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F3A22"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.danielalfaro.ledgercr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Tomá una foto del recibo para registrar la transacción automáticamente.",
        "NSPhotoLibraryUsageDescription": "Elegí una foto del recibo para registrar la transacción automáticamente."
      },
      "buildNumber": "15"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegí una foto del recibo para registrar la transacción automáticamente.",
          "cameraPermission": "Tomá una foto del recibo para registrar la transacción automáticamente."
        }
      ],
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usá Face ID para entrar a Ledger."
        }
      ],
      "./plugins/withApplePayIntent"
    ],
    "extra": {
      "phase": "6f",
      "block": "debt-D3",
      "eas": {
        "projectId": "be32f15e-2d4e-4297-85d6-f8ee1da01cc7"
      }
    },
    "owner": "alfaroda",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be32f15e-2d4e-4297-85d6-f8ee1da01cc7"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
