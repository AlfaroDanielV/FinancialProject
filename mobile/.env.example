# Mobile env (Expo)
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time.
# Copy to .env.local for local dev (not committed).

# Backend API base URL. The Expo client appends /api/v1 internally.
# When testing on a real device, use the host machine's LAN IP (not localhost).
# Example: http://192.168.1.42:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Sentry DSN (Phase 6f B15 — scaffold). Leave empty in Expo Go: the
# observability module stays a console no-op. Live Sentry needs the EAS dev
# build (@sentry/react-native native module) and lands at P8.
EXPO_PUBLIC_SENTRY_DSN=
